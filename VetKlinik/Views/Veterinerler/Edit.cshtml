@model VetKlinik.Models.Veteriner
@{
    ViewData["Title"] = "Hekimi Düzenle";
}

<h1>Hekimi Düzenle</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <partial name="_VeterinerFormu" model="Model" />
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="btn btn-link">Geri dön</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
